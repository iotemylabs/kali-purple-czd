{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/schedule/**",
              "components/structure/**",
              "components/wayfinding/**",
              "ui_kits/program-guide/**",
              "ui_kits/signage/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brandmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|src|assetBase|alt|style|key|ref|className|style|children)$/]",
        "message": "<Brandmark> doesn't accept that prop. Declared props: variant, height, src, assetBase, alt, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Brandmark'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:lockup|mark|wordmark)$/]",
        "message": "<Brandmark> variant must be one of 'lockup' | 'mark' | 'wordmark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EyebrowHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|marker|index|scale|rule|trailing|style|key|ref|className|style|children)$/]",
        "message": "<EyebrowHeader> doesn't accept that prop. Declared props: label, marker, index, scale, rule, trailing, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EyebrowHeader'] > JSXAttribute[name.name='scale'] > Literal[value!=/^(?:screen|print|signage)$/]",
        "message": "<EyebrowHeader> scale must be one of 'screen' | 'print' | 'signage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|width|height|scale|style|key|ref|className|style|children)$/]",
        "message": "<LogoSlot> doesn't accept that prop. Declared props: label, width, height, scale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LogoSlot'] > JSXAttribute[name.name='scale'] > Literal[value!=/^(?:screen|print|signage)$/]",
        "message": "<LogoSlot> scale must be one of 'screen' | 'print' | 'signage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapKeyItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:number|place|detail|scale|style|key|ref|className|style|children)$/]",
        "message": "<MapKeyItem> doesn't accept that prop. Declared props: number, place, detail, scale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapKeyItem'] > JSXAttribute[name.name='scale'] > Literal[value!=/^(?:screen|print|signage)$/]",
        "message": "<MapKeyItem> scale must be one of 'screen' | 'print' | 'signage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QRBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|primary|secondary|src|scale|style|key|ref|className|style|children)$/]",
        "message": "<QRBlock> doesn't accept that prop. Declared props: eyebrow, primary, secondary, src, scale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QRBlock'] > JSXAttribute[name.name='scale'] > Literal[value!=/^(?:screen|print|signage)$/]",
        "message": "<QRBlock> scale must be one of 'screen' | 'print' | 'signage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|vertical|style|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: variant, vertical, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hair|soft|bold)$/]",
        "message": "<Rule> variant must be one of 'hair' | 'soft' | 'bold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScheduleRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:start|end|title|byline|tag|room|variant|scale|state|capTop|capBottom|style|key|ref|className|style|children)$/]",
        "message": "<ScheduleRow> doesn't accept that prop. Declared props: start, end, title, byline, tag, room, variant, scale, state, capTop, capBottom, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScheduleRow'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:standard|emphasis|terminal)$/]",
        "message": "<ScheduleRow> variant must be one of 'standard' | 'emphasis' | 'terminal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScheduleRow'] > JSXAttribute[name.name='scale'] > Literal[value!=/^(?:screen|print|signage)$/]",
        "message": "<ScheduleRow> scale must be one of 'screen' | 'print' | 'signage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScheduleRow'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:now|past)$/]",
        "message": "<ScheduleRow> state must be one of 'now' | 'past'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|scale|tone|style|key|ref|className|style|children)$/]",
        "message": "<SessionTag> doesn't accept that prop. Declared props: label, scale, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionTag'] > JSXAttribute[name.name='scale'] > Literal[value!=/^(?:screen|print|signage)$/]",
        "message": "<SessionTag> scale must be one of 'screen' | 'print' | 'signage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SessionTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:gold|muted|deep)$/]",
        "message": "<SessionTag> tone must be one of 'gold' | 'muted' | 'deep'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|label|scale|style|key|ref|className|style|children)$/]",
        "message": "<StatusChip> doesn't accept that prop. Declared props: state, label, scale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:now|next|hold|stale)$/]",
        "message": "<StatusChip> state must be one of 'now' | 'next' | 'hold' | 'stale'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusChip'] > JSXAttribute[name.name='scale'] > Literal[value!=/^(?:screen|signage)$/]",
        "message": "<StatusChip> scale must be one of 'screen' | 'signage'."
      },
      {
        "selector": "JSXOpeningElement[name.name='WayfindingBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|destination|directions|time|arrow|scale|style|key|ref|className|style|children)$/]",
        "message": "<WayfindingBlock> doesn't accept that prop. Declared props: label, destination, directions, time, arrow, scale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WayfindingBlock'] > JSXAttribute[name.name='arrow'] > Literal[value!=/^(?:→|←|↑|↓|)$/]",
        "message": "<WayfindingBlock> arrow must be one of '→' | '←' | '↑' | '↓' | ''."
      },
      {
        "selector": "JSXOpeningElement[name.name='WayfindingBlock'] > JSXAttribute[name.name='scale'] > Literal[value!=/^(?:screen|print|signage)$/]",
        "message": "<WayfindingBlock> scale must be one of 'screen' | 'print' | 'signage'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
