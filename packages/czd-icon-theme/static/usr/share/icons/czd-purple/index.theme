[Icon Theme]
Name=CZD Purple
Comment=Charleston Zero Day icon theme: 33 gold glyphs on a 24-unit grid, everything else from Breeze Dark
Inherits=breeze-dark,hicolor
Example=folder
Directories=64x64/apps,scalable/apps,scalable/places,scalable/actions,scalable/status,scalable/devices,scalable/mimetypes,scalable/panel

[64x64/apps]
Size=64
Type=Fixed
Context=Applications

[scalable/apps]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/actions]
Size=22
MinSize=16
MaxSize=512
Type=Scalable
Context=Actions

[scalable/status]
Size=22
MinSize=16
MaxSize=512
Type=Scalable
Context=Status

[scalable/devices]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=Devices

[scalable/mimetypes]
Size=48
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[scalable/panel]
Size=22
MinSize=16
MaxSize=512
Type=Scalable
Context=Status
